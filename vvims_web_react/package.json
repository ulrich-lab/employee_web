{
  "name": "vvims-web-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fodecc": "cross-env NODE_ENV=fodecc next dev",
    "dev:cnps": "cross-env NODE_ENV=cnps next dev",
    "build": "next build",
    "build:fodecc": "cross-env NODE_ENV=fodecc next build",
    "build:cnps": "cross-env NODE_ENV=cnps next build",
    "start": "next start",
    "start:fodecc": "cross-env NODE_ENV=fodecc npx serve@latest out",
    "start:cnps": "cross-env NODE_ENV=cnps next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test-environments": "node scripts/test-environments.js",
    "analyze": "node scripts/analyze-bundle.js",
    "analyze:build": "ANALYZE=true npm run build",
    "performance": "npm run analyze && npm run type-check",
    "export:fodecc": "cross-env NODE_ENV=fodecc next build"
  },
  "dependencies": {
    "@apollo/client": "^3.8.8",
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@tanstack/react-query": "^5.17.9",
    "build": "^0.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.16",
    "graphql": "^16.8.1",
    "graphql-ws": "^6.0.6",
    "lucide-react": "^0.303.0",
    "next": "^15.4.5",
    "next-themes": "^0.4.6",
    "npm": "^11.5.2",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-intersection-observer": "^9.5.3",
    "react-use": "^17.4.2",
    "run": "^1.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}

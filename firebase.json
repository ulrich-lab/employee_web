{
  "hosting": {
    "public": "vvims_web_react/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/dashboard/**",
        "destination": "/dashboard/index.html"
      },
      {
        "source": "/user-type/**",
        "destination": "/user-type/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
